#!/usr/bin/env bash
#
# jacquinho - command line entry point for the Sabor da Maria agent.
#
#   jacquinho              open the chat
#   jacquinho up           start the background services only
#   jacquinho status       what is running, and is it healthy
#   jacquinho tools        list the MCP tools the agent can reach
#   jacquinho logs [svc]   follow logs
#   jacquinho confidence   watch the confidence of what the agent is about to say
#   jacquinho test         run the test suite
#   jacquinho down         stop everything
#   jacquinho reset        stop and DELETE all stored state
#   jacquinho login        sign in to Anthropic with a Claude subscription
#   jacquinho hermes ...   pass a command straight to the Hermes CLI
#   jacquinho install      link this script into ~/.local/bin
#
set -euo pipefail

# Resolve the repo even when reached through a symlink in ~/.local/bin.
SOURCE=${BASH_SOURCE[0]}
while [ -L "$SOURCE" ]; do
    DIR=$(cd -P "$(dirname "$SOURCE")" && pwd)
    SOURCE=$(readlink "$SOURCE")
    [[ $SOURCE != /* ]] && SOURCE=$DIR/$SOURCE
done
ROOT=$(cd -P "$(dirname "$SOURCE")/.." && pwd)
COMPOSE_FILE=$ROOT/dockerfile/docker-compose.yaml
ENV_FILE=$ROOT/dockerfile/.env

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
warn() { printf '\033[33m%s\033[0m\n' "$1" >&2; }
die()  { printf '\033[31m%s\033[0m\n' "$1" >&2; exit 1; }

if docker compose version >/dev/null 2>&1; then
    COMPOSE=(docker compose --progress quiet -f "$COMPOSE_FILE")
elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE=(docker-compose -f "$COMPOSE_FILE")
else
    die 'Docker Compose not found. Install Docker Desktop, or the docker-compose-plugin.'
fi

ensure_env() {
    local quiet_credentials=${1:-}
    if [ ! -f "$ENV_FILE" ]; then
        cp "$ROOT/dockerfile/.env.example" "$ENV_FILE"
        warn "Created dockerfile/.env from the example."
    fi
    # The provider is pinned in dockerfile/hermes-config.yaml. Credentials can
    # be an API key in .env, an OAuth token in the hermes-data volume, or
    # nothing at all when the provider is a local endpoint.
    # Pointless while the user is on their way to fix it.
    [ "$quiet_credentials" = skip-credentials ] && return 0

    if ! grep -qE '^[A-Z_]*(API_KEY|TOKEN|BASE_URL)=.+' "$ENV_FILE" \
       && ! docker run --rm -v jacquinho_hermes-data:/d alpine \
              test -f /d/auth.json >/dev/null 2>&1; then
        warn ''
        warn 'No model credentials found yet. Pick one:'
        warn '  jacquinho login    sign in with a Claude subscription (no API key)'
        warn '  or put a provider key in dockerfile/.env'
        warn '  or point hermes-config.yaml at a local Ollama - see the comments'
        warn ''
    fi
}

services_up() {
    ensure_env "${1:-}"
    # Rebuild on every start, so editing app/ can never leave a stale image
    # running while the code on disk says otherwise. Quiet, because with a warm
    # cache there is nothing to report: about five seconds and no output.
    printf 'Building'
    if ! "${COMPOSE[@]}" build --quiet jacquinho-mcp >/dev/null 2>&1; then
        printf '\n'
        die 'The MCP image failed to build. Run: docker compose -f '"$COMPOSE_FILE"' build'
    fi
    printf ' ok\nStarting Redis, Postgres and the MCP server'
    "${COMPOSE[@]}" up -d redis postgres jacquinho-mcp >/dev/null 2>&1
    for _ in $(seq 1 40); do
        if [ "$("${COMPOSE[@]}" ps --format '{{.Service}} {{.Health}}' \
                 | awk '$1=="jacquinho-mcp"{print $2}')" = healthy ]; then
            printf ' ok\n'
            return 0
        fi
        printf '.'
        sleep 2
    done
    printf '\n'
    die "The MCP server did not become healthy. Try: jacquinho logs jacquinho-mcp"
}

case "${1:-chat}" in
    chat)
        services_up
        bold ''
        bold 'Sabor da Maria - talk to the agent. Ctrl-C to leave.'
        bold ''
        # `run`, not `up`: the Hermes default command is an interactive TUI.
        # --accept-hooks: the two turn-boundary hooks ship with this repository
        # and are declared in its config, so the first-use consent prompt has
        # nobody to ask. They are readable in hooks/.
        HERMES_UID=$(id -u) HERMES_GID=$(id -g) \
            "${COMPOSE[@]}" run --rm hermes --accept-hooks
        ;;
    up)
        services_up
        bold 'Services are up. Open the chat with: jacquinho'
        ;;
    status)
        "${COMPOSE[@]}" ps --format 'table {{.Service}}\t{{.Status}}'
        ;;
    test)
        shift
        # The server tests exercise the real thing, so the stores it talks to
        # have to be up. The domain tests need nothing and run either way.
        services_up skip-credentials
        "${COMPOSE[@]}" run --rm --no-deps -T jacquinho-mcp \
            python -m pytest tests/ "$@"
        ;;
    tools)
        # Straight from the running server, so this cannot drift from the docs.
        services_up skip-credentials
        "${COMPOSE[@]}" run --rm --no-deps -T jacquinho-mcp python -c '
from app.mcps.server import MCPServer
from app.config import Settings
import asyncio

async def main():
    from fastmcp import Client
    async with Client(MCPServer(Settings.from_env()).root) as client:
        tools = await client.list_tools()
    for tool in sorted(tools, key=lambda t: t.name):
        head = (tool.description or "").strip().splitlines()[0]
        print(f"  {tool.name:<38} {head}")
    print(f"\n  {len(tools)} ferramentas")

asyncio.run(main())
'
        ;;
    logs)
        "${COMPOSE[@]}" logs -f "${2:-}"
        ;;
    confidence)
        # The agent never has to ask for this: the server scores its own evidence
        # trail after every tool call. Run it in a second terminal, beside the chat.
        bold 'Confidence of what the agent is about to say. Ctrl-C to leave.'
        bold ''
        "${COMPOSE[@]}" logs -f --no-log-prefix jacquinho-mcp 2>/dev/null \
            | grep --line-buffered '^jacquinho.confidence ' \
            | python3 -u "$ROOT/bin/_confidence_view.py"
        ;;
    down)
        "${COMPOSE[@]}" down
        ;;
    reset)
        warn 'This deletes the chat history, the recipe catalogue with every'
        warn 'block on it, her kitchen profile, the budget ledger and the launch'
        warn 'menu. The spreadsheet is untouched, and so is your login.'
        read -r -p 'Type RESET to confirm: ' answer
        [ "$answer" = RESET ] || die 'Cancelled.'
        "${COMPOSE[@]}" down
        # Only the stores that hold HER data. hermes-data holds the OAuth token
        # and the agent's own memory: wiping it to reset a consultation costs a
        # browser round-trip to log in again, for nothing.
        for volume in jacquinho_postgres-data jacquinho_redis-data; do
            docker volume rm "$volume" >/dev/null 2>&1 || true
        done
        # Hermes keeps its own transcript, next to the token, in the volume we
        # are deliberately not deleting. Emptying the stores and leaving that
        # behind gives a reset that still opens on the old conversation, which
        # is the confusing half-state. Delete the rows; keep auth.json.
        docker run --rm -v jacquinho_hermes-data:/d alpine sh -c '
            apk add -q sqlite 2>/dev/null || exit 0
            [ -f /d/state.db ] || exit 0
            sqlite3 /d/state.db "delete from messages;
                                 delete from session_model_usage;
                                 delete from session_turn_leases;
                                 delete from sessions;
                                 delete from system_prompts;
                                 VACUUM;"
            rm -rf /d/cache/web/*
        ' >/dev/null 2>&1 || warn 'Hermes transcript left in place.'
        bold 'Her data is gone, and so is the transcript. Your login is not.'
        ;;
    login)
        services_up skip-credentials
        bold ''
        bold 'Signing in to Anthropic. This uses a Claude subscription rather'
        bold 'than an API key. The token is stored in the hermes-data volume,'
        bold 'so this is a one-off.'
        bold ''
        warn 'There is no browser inside the container: copy the URL it prints'
        warn 'into the browser on this machine, then paste the code back here.'
        bold ''
        HERMES_UID=$(id -u) HERMES_GID=$(id -g) \
            "${COMPOSE[@]}" run --rm hermes auth add anthropic \
                --type oauth --no-browser
        ;;
    hermes)
        shift
        services_up
        HERMES_UID=$(id -u) HERMES_GID=$(id -g) \
            "${COMPOSE[@]}" run --rm hermes --accept-hooks "$@"
        ;;
    install)
        mkdir -p "$HOME/.local/bin"
        ln -sf "$ROOT/bin/jacquinho" "$HOME/.local/bin/jacquinho"
        bold "Linked $HOME/.local/bin/jacquinho -> $ROOT/bin/jacquinho"
        case ":$PATH:" in
            *":$HOME/.local/bin:"*) bold 'Ready. Run: jacquinho' ;;
            *) warn "$HOME/.local/bin is not on your PATH. Add it to ~/.bashrc:"
               warn '  export PATH="$HOME/.local/bin:$PATH"' ;;
        esac
        ;;
    -h|--help|help)
        # Print the header comment block and stop at the first line that is not one.
        sed -n '3,${/^#/!q;s/^# \{0,1\}//;p;}' "$SOURCE" 
        ;;
    *)
        die "Unknown command '${1}'. Try: jacquinho help"
        ;;
esac
