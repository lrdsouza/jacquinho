# Copy to .env and fill in. Do not commit .env.

# --- Model provider ---------------------------------------------------------
# The model and provider are pinned in hermes-config.yaml. Only one model is
# ever in the loop: the confidence layer's judging turn is the same model under
# a stricter rubric, not a second provider.
#
# The shipped configuration uses Anthropic. Paste the key and nothing else is
# needed.
ANTHROPIC_API_KEY=

# To run on something else, change model.provider in hermes-config.yaml and set
# the matching credential here. A local OpenAI-compatible server needs no
# account: the host is mapped as host.docker.internal.
#   Ollama:     OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#               OPENAI_API_KEY=ollama
#   LM Studio:  OPENAI_BASE_URL=http://host.docker.internal:1234/v1
#               OPENAI_API_KEY=lmstudio
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# --- Where she cooks and sells ----------------------------------------------
# Drives competitor price search and which regional IPCA is read.
# IBGE_LOCALITY is the IPCA area code: N7[3501] is metropolitan Sao Paulo.
LOCALE_CITY=Sao Paulo
LOCALE_STATE=SP
IBGE_LOCALITY=N7[3501]

# --- Recipe search ----------------------------------------------------------
# 'auto' prefers Brave when a key is present, else the keyless DuckDuckGo
# fallback. Brave is the reliable path; the fallback scrapes HTML.
SEARCH_PROVIDER=auto
BRAVE_API_KEY=

# --- File ownership ---------------------------------------------------------
# jacquinho passes these automatically; they matter only for a raw
# `docker compose run`.
HERMES_UID=1000
HERMES_GID=1000
